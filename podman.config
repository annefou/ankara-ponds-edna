// PEMA names some of its containers without a registry (e.g. hariszaf/pema-nf:0.3.0, on Docker Hub).
// Ubuntu's Podman has no default search registry, so Nextflow is told to prefix such names with docker.io.
// Images that already name their registry (quay.io/biocontainers/...) are not changed.
podman.registry = 'docker.io'
